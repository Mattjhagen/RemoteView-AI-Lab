# Install as /etc/remoteview-ai.env, root:root, mode 0600. Not an active config.
OLLAMA_BASE_URL=http://100.92.82.62:11434
OLLAMA_MODEL=qwen2.5-coder:3b
PUBLIC_ORIGIN=https://airemoteview.buzz
TRUSTED_HOSTS=airemoteview.buzz,127.0.0.1,localhost
# Only a cloudflared process connecting over IPv4 loopback is trusted.
TRUSTED_PROXIES=127.0.0.1/32
COOKIE_SECURE=true
# Replace this line using python3 -m remoteview.password. Blank intentionally fails startup.
AUTH_PASSWORD_HASH=
AUTH_SESSION_TTL=43200
MAX_REQUEST_BYTES=40000
RATE_LIMIT_PER_MINUTE=120
LOGIN_LIMIT_PER_MINUTE=5
INFERENCE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_INFERENCE=2
MAX_HTTP_WORKERS=24
REQUEST_TIMEOUT=15
